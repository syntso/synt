(component
  (import "synt:extension/types@0.1.0" (instance $types
    (type $risk-def (enum "read" "write" "privileged"))
    (export "risk" (type $risk (eq $risk-def)))
    (type $action-def (record
      (field "id" string)
      (field "title" string)
      (field "risk" $risk)
      (field "takes-target" bool)
      (field "params-schema" string)))
    (export "action" (type (eq $action-def)))
    (type $error-def (record (field "code" string) (field "message" string)))
    (export "error" (type (eq $error-def)))
    (type $level-def (enum "trace" "debug" "info" "warn" "error"))
    (export "level" (type (eq $level-def)))))
  (alias export $types "action" (type $action))
  (alias export $types "error" (type $error))
  (alias export $types "level" (type $level))

  (import "storage-get" (func $storage-get (param "key" string) (result (option (list u8)))))
  (import "log" (func $log (param "level" $level) (param "message" string)))

  (core module $Memory
    (memory (export "memory") 2)
    (global $heap (mut i32) (i32.const 32768))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $start i32)
      (local.set $start (global.get $heap))
      (global.set $heap
        (i32.add (global.get $heap) (i32.and (i32.add (local.get 3) (i32.const 7)) (i32.const -8))))
      (local.get $start)))
  (core instance $memory (instantiate $Memory))
  (alias core export $memory "memory" (core memory $mem))
  (alias core export $memory "realloc" (core func $realloc))

  (core func $storage-get-lowered (canon lower (func $storage-get) (memory $mem) (realloc $realloc)))
  (core func $log-lowered (canon lower (func $log) (memory $mem)))

  (core module $Main
    (import "env" "memory" (memory 1))
    (import "host" "storage-get" (func $storage-get (param i32 i32 i32)))
    (import "host" "log" (func $log (param i32 i32 i32)))
    (table $grown 1 funcref)
    (data (i32.const 64) "{\22type\22:\22object\22}")
    (data (i32.const 96) "h.table")
    (data (i32.const 104) "h.store")
    (data (i32.const 112) "h.log")
    (data (i32.const 120) "Hog")
    (data (i32.const 128) "k")
    (data (i32.const 136) "a line")
    (data (i32.const 1024) "\00\08\00\00\03\00\00\00")
    (data (i32.const 2048) "\60\00\00\00\07\00\00\00\78\00\00\00\03\00\00\00\00\00\00\00\40\00\00\00\11\00\00\00\68\00\00\00\07\00\00\00\78\00\00\00\03\00\00\00\00\00\00\00\40\00\00\00\11\00\00\00\70\00\00\00\05\00\00\00\78\00\00\00\03\00\00\00\00\00\00\00\40\00\00\00\11\00\00\00")
    (func $ok (result i32)
      (i32.store8 (i32.const 1100) (i32.const 0))
      (i32.store (i32.const 1104) (i32.const 64))
      (i32.store (i32.const 1108) (i32.const 17))
      (i32.const 1100))
    (func $repeat (param $times i32) (param $log i32)
      (loop $again
        (if (local.get $log)
          (then (call $log (i32.const 2) (i32.const 136) (i32.const 6)))
          (else (call $storage-get (i32.const 128) (i32.const 1) (i32.const 1200))))
        (local.set $times (i32.sub (local.get $times) (i32.const 1)))
        (br_if $again (i32.gt_s (local.get $times) (i32.const 0)))))
    (func (export "describe") (result i32)
      (i32.const 1024))
    (func (export "run") (param i32 i32 i32 i32 i32 i32 i32) (result i32)
      (local $letter i32)
      (local.set $letter (i32.load8_u offset=2 (local.get 0)))
      (if (i32.eq (local.get $letter) (i32.const 116))
        (then (drop (table.grow $grown (ref.null func) (i32.const 1000000)))))
      (if (i32.eq (local.get $letter) (i32.const 115))
        (then (call $repeat (i32.const 2000) (i32.const 0))))
      (if (i32.eq (local.get $letter) (i32.const 108))
        (then (call $repeat (i32.const 1000) (i32.const 1))))
      (call $ok)))
  (core instance $main (instantiate $Main
    (with "env" (instance (export "memory" (memory $mem))))
    (with "host" (instance
      (export "storage-get" (func $storage-get-lowered))
      (export "log" (func $log-lowered))))))
  (core module $Extra (memory 1))

  (func $describe (result (list $action))
    (canon lift (core func $main "describe") (memory $mem)))
  (func $run
    (param "action" string)
    (param "target" (option string))
    (param "params" string)
    (result (result string (error $error)))
    (canon lift (core func $main "run") (memory $mem) (realloc $realloc)))
  (export "describe" (func $describe))
  (export "run" (func $run)))
