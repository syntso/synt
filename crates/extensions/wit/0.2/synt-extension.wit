package synt:extension@0.2.0;

interface types {
    enum risk {
        read,
        write,
        privileged,
    }

    record action {
        id: string,
        title: string,
        risk: risk,
        takes-target: bool,
        params-schema: string,
    }

    record error {
        code: string,
        message: string,
    }

    enum level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    record event {
        kind: string,
        payload: string,
    }
}

interface host {
    use types.{error, level};

    call: func(action: string, target: option<string>, params: string) -> result<string, error>;
    log: func(level: level, message: string);
    settings: func() -> string;
}

interface storage {
    use types.{error};

    get: func(key: string) -> option<list<u8>>;
    set: func(key: string, value: list<u8>) -> result<_, error>;
}

interface http {
    use types.{error};

    record header {
        name: string,
        value: string,
    }

    record secret-header {
        name: string,
        secret: string,
        prefix: string,
    }

    record request {
        method: string,
        url: string,
        headers: list<header>,
        secrets: list<secret-header>,
        body: option<list<u8>>,
        timeout-ms: option<u32>,
    }

    record response {
        status: u16,
        headers: list<header>,
        body: list<u8>,
    }

    send: func(request: request) -> result<response, error>;
}

interface documents {
    use types.{error};

    record document-info {
        project: string,
        path: string,
        kind: string,
        revision: string,
        size: u64,
    }

    record document {
        info: document-info,
        body: list<u8>,
    }

    record written {
        info: document-info,
        merged: bool,
    }

    listing: func(project: string) -> result<list<document-info>, error>;
    read: func(project: string, path: string) -> result<document, error>;
    write: func(project: string, path: string, body: list<u8>, base: option<string>) -> result<written, error>;
    remove: func(project: string, path: string) -> result<_, error>;
}

interface files {
    use types.{error};

    enum access {
        read,
        read-write,
    }

    record picked {
        handle: string,
        name: string,
        access: access,
    }

    chosen: func() -> list<picked>;
    read: func(handle: string) -> result<list<u8>, error>;
    write: func(handle: string, body: list<u8>) -> result<_, error>;
}

interface timers {
    use types.{error};

    set: func(name: string, every-seconds: u32) -> result<_, error>;
    clear: func(name: string);
}

interface ui {
    use types.{error};

    patch-view: func(view: string, patch: string) -> result<_, error>;
    post: func(panel: string, message: string) -> result<_, error>;
}

world extension {
    import host;
    import storage;
    import http;
    import documents;
    import files;
    import timers;
    import ui;

    use types.{action, error, event};

    export describe: func() -> list<action>;
    export run: func(action: string, target: option<string>, params: string) -> result<string, error>;
    export start: func() -> result<_, error>;
    export render: func(view: string, target: option<string>, params: string) -> result<string, error>;
    export panel-message: func(panel: string, message: string) -> result<string, error>;
    export asset: func(path: string) -> option<list<u8>>;
    export on-event: func(event: event) -> result<_, error>;
    export on-timer: func(name: string) -> result<_, error>;
    export merge: func(kind: string, base: option<list<u8>>, ours: list<u8>, theirs: list<u8>) -> result<list<u8>, error>;
}
